{
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"parserOptions": {
		"sourceType": "module"
	},
	"extends": "eslint:recommended",
	"rules": {
		"indent": "off",
		"brace-style": "off",
		"no-mixed-spaces-and-tabs": "off",
		"no-useless-escape": "off",
		"space-unary-ops": ["error", { "words": true }],
		"linebreak-style": "off",
		"quotes": ["off"],
		"semi": "off",
		"camelcase": "off",
		"no-unused-vars": "off",
		"no-console": ["warn"],
		"no-extra-boolean-cast": ["off"],
		"no-control-regex": ["off"],
		"no-restricted-syntax": [
			"warn",
			{
				"selector": "JSXAttribute[name.name='className'] Literal[value=/\\bdark:/]",
				"message": "SEEF-TRP2: Tailwind 'dark:' variants bypass the SEEF theme engine. Use semantic tokens (bg-theme-surface-*, text-theme-primary, text-theme-muted, var(--c-seef-accent)) instead. See docs/adr/SEEF-TRP2.md."
			}
		],
	"root": true
}
