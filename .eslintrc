{
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"parserOptions": {
		"sourceType": "module"
	},
	"extends": "eslint:recommended",
	"rules": {
		"indent": "off",
		"brace-style": "off",
		"no-mixed-spaces-and-tabs": "off",
		"no-useless-escape": "off",
		"space-unary-ops": ["error", { "words": true }],
		"linebreak-style": "off",
		"quotes": ["off"],
		"semi": "off",
		"camelcase": "off",
		"no-unused-vars": "off",
		"no-console": ["warn"],
		"no-extra-boolean-cast": ["off"],
		"no-control-regex": ["off"],
		"no-restricted-syntax": [
			"warn",
			{
				"selector": "JSXAttribute[name.name='className'] Literal[value=/\\bdark:/]",
				"message": "[TGR-001] Tailwind 'dark:' variants bypass the SEEF theme engine. Use semantic tokens: bg-theme-surface-*, text-theme-primary, text-theme-muted, border-theme-divider. See SEEF-TRP2."
			},
			{
				"selector": "JSXAttribute[name.name='className'] Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
				"message": "[TGR-002] Hardcoded hex colors in className are not theme-aware. Replace with semantic tokens: var(--c-seef-accent), var(--c-theme-surface-1), etc. See SEEF-TRP2."
			},
			{
				"selector": "JSXAttribute[name.name='className'] Literal[value=/\\brgba?\\s*\\(/]",
				"message": "[TGR-003] rgb()/rgba() literals in className are not theme-aware. Use semantic token vars or Tailwind opacity modifiers on token classes. See SEEF-TRP2."
			},
			{
				"selector": "JSXAttribute[name.name='style'] Property[key.name=/^(color|background|backgroundColor|borderColor|fill|stroke|outlineColor)$/] Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
				"message": "[TGR-004] Hardcoded color literal in style prop. Use var(--c-seef-*) or var(--c-theme-*) tokens instead. See SEEF-TRP2."
			}
		],
	"root": true
}
