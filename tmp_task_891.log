            CustomerCreate(
                id=f"cust-{suffix}",
                customer_group_id=f"cg-{suffix}",
                name="Test Customer",
                mobile=mobile_num
            )
        )
        assert customer.name == "Test Customer"
    
        # Try duplicate mobile
