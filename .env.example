# SMRITI Retail OS AI Intelligence Credentials
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Platform Abstraction Layer (PAL) Provider Options
DATABASE_PROVIDER=postgres
SYNC_PROVIDER=postgres
CACHE_PROVIDER=memory
STORAGE_PROVIDER=filesystem

# PostgreSQL Standalone Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:2781/smritisys
POSTGRES_PORT=2781
BACKEND_API_PORT=1981
PORT=8101

# Docker-Compose Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smritisys

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: JWT Secret Key
# MUST be set before starting the backend. Leaving this empty causes ALL API
# endpoints to return 500 Internal Server Error.
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Internal Service Key
# MUST be set before starting the backend. Must be different from JWT_SECRET_KEY.
# Leaving this empty causes ALL API endpoints to return 500 Internal Server Error.
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_SERVICE_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# Optional Default Bank Details for Invoicing (fallback if not configured in Company Tax Profile)
DEFAULT_BANK_NAME=
DEFAULT_BANK_ACCOUNT_NO=
DEFAULT_BANK_IFSC=
DEFAULT_BANK_BRANCH=

# ─────────────────────────────────────────────────────────────────────────────
# Company / Business Profile (set during installation)
# ─────────────────────────────────────────────────────────────────────────────
SMRITI_COMPANY_NAME=
SMRITI_COMPANY_CODE=
SMRITI_COMPANY_GST=
SMRITI_BRANCH_NAME=
SMRITI_BRANCH_CODE=
SMRITI_ADMIN_USERNAME=admin
SMRITI_ADMIN_EMAIL=
SMRITI_ADMIN_PASSWORD=Admin@123
SGIP_VAULT_MASTER_KEY=
