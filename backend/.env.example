# SMRITI Retail OS AI Intelligence Credentials
# ⚠️  IMPORTANT: Set GEMINI_API_KEY via environment variable or secrets manager
GEMINI_API_KEY=${GEMINI_API_KEY}

# ⚠️  CRITICAL: DO NOT COMMIT SECRETS TO GIT
# Generate secure random secrets using:
#   openssl rand -hex 32
# Or set via environment variables / secrets manager
JWT_SECRET_KEY=${JWT_SECRET_KEY}
INTERNAL_SERVICE_KEY=${INTERNAL_SERVICE_KEY}
SGIP_VAULT_MASTER_KEY=${SGIP_VAULT_MASTER_KEY}

# Platform Abstraction Layer (PAL) Provider Options
DATABASE_PROVIDER=postgres
SYNC_PROVIDER=postgres
CACHE_PROVIDER=memory
STORAGE_PROVIDER=filesystem

# PostgreSQL Standalone Configuration
# Use environment variables for database credentials in production
# Example: DATABASE_URL="postgresql://user:password@host:port/dbname"
DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/smritisys}

# Docker-Compose Settings
# Override these in production environment
POSTGRES_USER=${POSTGRES_USER:-postgres}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres}
POSTGRES_DB=${POSTGRES_DB:-smritisys}
POSTGRES_PORT=${POSTGRES_PORT:-5432}

# Application Port
PORT=${PORT:-3000}
